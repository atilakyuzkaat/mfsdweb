# --- E-posta (Resend: https://resend.com) ---
# Resend'de mfsd.com.tr alan adını doğrulayın (DNS'e SPF/DKIM kayıtları eklenir).
RESEND_API_KEY=
# Gönderen adres (doğrulanmış alan adından olmalı)
MAIL_FROM="MFSD <bildirim@mfsd.com.tr>"
# İletişim formu mesajlarının düşeceği kutu
CONTACT_TO=info@mfsd.com.tr
# Formu dolduran kişiye otomatik "mesajınız alındı" e-postası gönderilsin mi
CONTACT_AUTO_REPLY=true
# Bülten aboneleri Resend Audience listesine eklenir (Resend > Audiences > ID). Boşsa yalnızca CONTACT_TO'ya bildirim gider.
RESEND_AUDIENCE_ID=

# Sitenin canlı adresi (sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.mfsd.com.tr
